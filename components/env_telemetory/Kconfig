menu "Environment telemetry"

    config ENV_TELEMETRY_HTTP_URL
        string "HTTP endpoint URL"
        default ""
        help
            Full URL of the FastAPI endpoint, for example:
            http://192.168.1.100:8000/api/data
            Use the server address reachable from the ESP32's Wi-Fi network.
            Set this before running the firmware; an empty URL fails init.

endmenu

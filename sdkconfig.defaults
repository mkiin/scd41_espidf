# FreeRTOS tick = 10 ms; sensor timing is handled by the HAL.
CONFIG_FREERTOS_HZ=100
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Console uses UART0 (TX GPIO43 / RX GPIO44), normally via a USB-UART bridge.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# Also mirror application logs to the ESP32-S3 native USB Serial/JTAG port.
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

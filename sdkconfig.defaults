# FreeRTOS tick = 10 ms; sensor timing is handled by the HAL.
CONFIG_FREERTOS_HZ=100
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Console uses UART0 (TX GPIO43 / RX GPIO44), normally via a USB-UART bridge.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# Keep UART logging; disable the secondary USB console for light sleep.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
